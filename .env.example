# ──────────────────────────────────────────────────────────────────────────────
# Nifty Trading System — Environment Variables Template (Azure VM deployment)
#
# Copy this file to .env and fill in the real values before running docker compose.
# On the VM:  chmod 600 .env   — .env is gitignored — NEVER commit real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Container images (GHCR) ───────────────────────────────────────────────────
# Your GitHub username/org that owns the pushed images, and the tag to run.
GHCR_OWNER=
IMAGE_TAG=latest

# ── Database — Azure Database for PostgreSQL (Flexible Server, managed) ────────
# Full JDBC URL to the managed endpoint.
#   - sslmode=require is MANDATORY (Azure enforces TLS)
#   - currentSchema=zupptrade_dev is MANDATORY: all tables live in the zupptrade_dev schema,
#     and raw JdbcTemplate queries (agent5, token loader) rely on the connection search_path.
# Example:
#   jdbc:postgresql://zupptrade-pg.postgres.database.azure.com:5432/nifty_trading?sslmode=require&currentSchema=zupptrade_dev
DB_URL=
# Flexible Server admin login (just the username — no @server suffix) and password.
DB_USERNAME=zuppadmin
DB_PASSWORD=

# ── Internal API Key ─────────────────────────────────────────────────────────
# Shared X-API-Key for agent-to-agent calls (any strong random string).
INTERNAL_API_KEY=change_me_internal_key

# ── Upstox ────────────────────────────────────────────────────────────────────
# Get from Upstox Developer Portal → Your Apps → API Key / Secret
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Daily access token — populated automatically by upstox-auth at 08:30 AM IST.
# For first-start or manual override, paste a valid token here.
UPSTOX_ACCESS_TOKEN=

# ── Agent 5 order placement ───────────────────────────────────────────────────
# "sandbox" (default) = simulated fills, NO real orders — safe for paper trading.
# Leave EMPTY (AGENT5_PROFILE=) to place REAL orders on api-hft.upstox.com.
AGENT5_PROFILE=sandbox
# Upstox sandbox order token — used when AGENT5_PROFILE=sandbox (safe to leave blank;
# sandbox simulates fills, so orders aren't actually sent).
UPSTOX_SANDBOX_TOKEN=

# AES-256 encryption key for the token stored in DB (32-char hex or base64 string)
TOKEN_ENCRYPTION_KEY=

# Upstox login credentials — used by upstox-auth to obtain the daily token
UPSTOX_USERNAME=
UPSTOX_PASSWORD=
UPSTOX_TOTP_SEED=         # TOTP seed (NOT the OTP — the TOTP secret from Upstox 2FA setup)
UPSTOX_REDIRECT_URI=http://localhost:8080/callback

# ── Marketaux (news sentiment — free tier 100 req/day) ───────────────────────
MARKETAUX_API_KEY=

# ── Groq (LLM commentary extraction in Agent 1) ───────────────────────────────
GROQ_API_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# MULTI-USER LOGIN & DATA ISOLATION  (added for the multi-user rollout)
# ══════════════════════════════════════════════════════════════════════════════
#
# NOTE on the two Upstox apps:
#   UPSTOX_API_KEY / UPSTOX_API_SECRET (above)  = MARKET-DATA app (used by upstox-auth to
#        fetch the shared admin token; its redirect is the internal :8080 flow).
#   UPSTOX_LOGIN_API_KEY / _SECRET (below)      = a SEPARATE Upstox app for END-USER LOGIN,
#        registered with the PUBLIC https callback. Upstox allows only ONE redirect per app,
#        which is why login needs its own app.

# ── Session signing (JWT) — shared by ALL agents + agent-user ─────────────────
# HS256 secret, >= 32 characters. MUST be the SAME value everywhere. If you point Azure at a
# database that already holds sessions, reuse the exact key those were signed with.
JWT_SIGNING_KEY=

# ── Google OIDC login (SIMULATION users) ──────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client.
# Add the redirect URI below to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://zupptrade.centralindia.cloudapp.azure.com/api/agent-user/auth/google/callback

# ── Upstox login app (LIVE users) ─────────────────────────────────────────────
# A NEW Upstox app whose Redirect URL is exactly UPSTOX_AUTH_REDIRECT below.
UPSTOX_LOGIN_API_KEY=
UPSTOX_LOGIN_API_SECRET=
UPSTOX_AUTH_REDIRECT=https://zupptrade.centralindia.cloudapp.azure.com/api/agent-user/auth/upstox/callback

# ── Where agent-user hands the browser back after login (the SPA callback route) ──
AUTH_UI_REDIRECT=https://zupptrade.centralindia.cloudapp.azure.com/auth/callback
