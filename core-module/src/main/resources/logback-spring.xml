<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logging config for ALL zupptrade agents — core-module is a dependency of every agent, so
  this file is on each one's classpath and needs to exist in exactly one place.

  Appenders:
    * CONSOLE — human-readable under the `local` profile, JSON (Logstash) otherwise, so `docker logs`
                / stdout stays useful in dev and structured in prod (CLAUDE.md §4).
    * JSON_FILE — rolling JSON file at ${LOG_PATH}/<app-name>.log, size+time rolling with a total-size
                  cap so the disk never fills. Written in ALL profiles.

  The file NAME comes from spring.application.name (each agent sets it), the DIRECTORY from LOG_PATH
  (env var; defaults to ./logs for local runs — set LOG_PATH=/var/log/zupptrade in containers).

  An agent that genuinely needs different logging may add its own logback-spring.xml (an agent's own
  classpath entry takes precedence over this dependency copy).
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="zupptrade"/>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- Rolling JSON file — one file per service, always on -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${appName}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${appName}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeCallerData>false</includeCallerData>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Local dev: plain, readable console -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Prod / sandbox / simulation / default: JSON console (structured) -->
    <springProfile name="!local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>false</includeCallerData>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <level>level</level>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <!-- Levels (was previously only in agent2's local config). Loggers inherit the root appenders. -->
    <logger name="com.the3Cgrp.zupptrade" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>

</configuration>
